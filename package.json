{
  "name": "hermann-planner",
  "version": "0.1.0",
  "description": "Personal Windows desktop widget replacing TickTick's paid calendar widget - shows Google Calendar events and Google Tasks in an always-on-top mini window",
  "main": "src/main/main.js",
  "author": "junganim518@gmail.com",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-window-state": "^5.0.3",
    "googleapis": "^144.0.0"
  },
  "build": {
    "appId": "com.hermann.planner",
    "productName": "Hermann Planner",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "directories": {
      "output": "dist"
    }
  }
}
